{%- comment -%}
  Link in Bio — the homepage template. One semantic structure for every
  layout; `data-layout` picks the CSS variant (theme.css, "Layouts").
  The link-item markup has a twin in index.liquid (no partials in v1) —
  keep the two in step.
{%- endcomment -%}
{%- assign o = page.page_options -%}
{%- assign name = o.name | default: site.name -%}
{%- assign bio = o.bio | default: site.description -%}
{%- assign layout = o.layout | default: "classic list" | replace: " ", "-" -%}
{%- assign words = name | split: " " -%}
{%- capture initials -%}{{ words.first | slice: 0, 1 }}{% if words.size > 1 %}{{ words.last | slice: 0, 1 }}{% endif %}{%- endcapture -%}

{%- capture socials_html -%}
{%- assign shown = 0 -%}
{%- capture items -%}
{%- for s in o.socials -%}
  {%- assign u = s.url | strip -%}{%- assign ul = u | downcase -%}
  {%- assign p8 = ul | slice: 0, 8 -%}{%- assign p7 = ul | slice: 0, 7 -%}
  {%- if p8 == "https://" or p7 == "http://" or p7 == "mailto:" -%}
    {%- assign shown = shown | plus: 1 -%}
{%- case s.network -%}
