{%- endcapture -%}

<div class="bio" data-layout="{{ layout }}">
  <div class="bio__side">
    <header class="profile">
      {%- if o.avatar != "" %}
      <img class="avatar" src="{{ o.avatar }}" alt="{{ o.avatar_alt | default: name | escape }}" width="112" height="112" fetchpriority="high" />
      {%- else %}
      <span class="avatar avatar--initials" aria-hidden="true">{{ initials | upcase | escape }}</span>
      {%- endif %}
      <h1 class="profile__name">{{ name | escape }}</h1>
      {%- if o.status != "" %}
      <p class="status"><span class="status__dot" aria-hidden="true"></span>{{ o.status | escape }}</p>
      {%- endif %}
      {%- if bio != "" %}
      <p class="profile__bio">{{ bio | escape | newline_to_br }}</p>
      {%- endif %}
    </header>
    {%- unless o.socials_position == "bottom of page" %}{{ socials_html }}{% endunless %}
  </div>

  <div class="bio__main">
    <ul class="links">
      {%- for l in o.links -%}
        {%- if l.show == false or l.title == "" -%}{%- continue -%}{%- endif -%}
        {%- if l.kind == "heading" %}
      <li class="links__heading"><h2>{{ l.title | escape }}</h2></li>
          {%- continue -%}
        {%- endif -%}
        {%- comment -%} Only http(s), mailto:, tel: and site paths get an href — `url` fields aren't scheme-checked by the platform. {%- endcomment -%}
        {%- assign u = l.url | strip -%}{%- assign ul = u | downcase -%}
        {%- assign p8 = ul | slice: 0, 8 -%}{%- assign p7 = ul | slice: 0, 7 -%}{%- assign p4 = ul | slice: 0, 4 -%}{%- assign p1 = ul | slice: 0, 1 -%}
        {%- assign external = false -%}{%- assign ok = false -%}
        {%- if p8 == "https://" or p7 == "http://" -%}{%- assign external = true -%}{%- assign ok = true -%}{%- endif -%}
        {%- if p7 == "mailto:" or p4 == "tel:" or p1 == "/" -%}{%- assign ok = true -%}{%- endif -%}
        {%- unless ok -%}{%- continue -%}{%- endunless %}
      <li class="link{% if l.kind == 'featured' %} link--featured{% endif %}{% if l.image != '' %} link--has-image{% endif %}">
        <a class="link__a" href="{{ u | escape }}"{% if external %} rel="noopener"{% endif %}>
          {%- if l.image != "" %}
          <img class="link__media" src="{{ l.image }}" alt="" loading="lazy" decoding="async" />
          {%- else %}
          <span class="link__media link__media--placeholder" aria-hidden="true">{{ l.title | slice: 0, 1 | upcase | escape }}</span>
          {%- endif %}
          <span class="link__body">
            <span class="link__title">{{ l.title | escape }}</span>
            {%- if l.description != "" %}<span class="link__desc">{{ l.description | escape }}</span>{% endif %}
          </span>
          <span class="link__arrow" aria-hidden="true">{% if external %}↗{% else %}→{% endif %}</span>
        </a>
      </li>
      {%- endfor -%}
      {%- if o.show_pages -%}
        {%- for p in pages -%}
          {%- if p.slug == page.slug -%}{%- continue -%}{%- endif %}
      <li class="link">
        <a class="link__a" href="{{ p.url }}">
          <span class="link__media link__media--placeholder" aria-hidden="true">{{ p.title | slice: 0, 1 | upcase | escape }}</span>
          <span class="link__body"><span class="link__title">{{ p.title | escape }}</span></span>
          <span class="link__arrow" aria-hidden="true">→</span>
        </a>
      </li>
        {%- endfor -%}
      {%- endif %}
    </ul>

    {%- if o.show_recent_posts and posts != empty %}
    {%- assign n = o.recent_posts_count | default: 3 %}
    <section class="writing" aria-labelledby="writing-title">
      <h2 id="writing-title" class="section-title">{{ o.recent_posts_title | default: "Writing" | escape }}</h2>
      <ul class="writing__list">
        {%- for post in posts limit: n %}
        <li>
          <a class="post-row" href="{{ post.url }}">
            {%- if post.post_options.featured_image != "" %}
            <img class="post-row__thumb" src="{{ post.post_options.featured_image }}" alt="" loading="lazy" decoding="async" width="64" height="64" />
            {%- endif %}
            <span class="post-row__title">{{ post.title | escape }}</span>
            {%- if post.published_at %}
            <time class="post-row__date" datetime="{{ post.published_at | iso8601 }}">{{ post.published_at | strftime: "%b %-d, %Y" }}</time>
            {%- endif %}
          </a>
        </li>
        {%- endfor %}
      </ul>
    </section>
    {%- endif %}

    {%- if o.socials_position == "bottom of page" %}{{ socials_html }}{% endif %}
  </div>
</div>
