<article class="doc">
  <p class="crumb"><a href="/">← {{ site.name | escape }}</a></p>
  <header class="doc__header">
    <h1 class="doc__title">{{ post.title | escape }}</h1>
    {%- if post.published_at %}
    <time class="doc__date" datetime="{{ post.published_at | iso8601 }}">{{ post.published_at | strftime: "%B %-d, %Y" }}</time>
    {%- endif %}
  </header>
  {%- if post.post_options.featured_image != "" %}
  <img class="doc__image" src="{{ post.post_options.featured_image }}" alt="" />
  {%- endif %}
  <div class="prose">
    {{ body_html }}
  </div>
  {%- if post.tags != empty %}
  <ul class="tags" aria-label="Tags">
    {%- for tag in post.tags %}
    <li><span>{{ tag.name | escape }}</span></li>
    {%- endfor %}
  </ul>
  {%- endif %}
</article>
